DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Geliştirmede komutları tek sunucuya anında yüklemek için kullanılır.
DISCORD_GUILD_ID=
DATABASE_URL=postgresql://user:password@host:5432/database
# Virgülle ayrılmış Discord rol kimlikleri. Sunucu yöneticileri her durumda DM sayılır.
ADMIN_ROLE_IDS=
AUTO_TURN_SCHEDULE=false
TURN_TIMEZONE=Europe/Istanbul
PORT=3000
LOG_LEVEL=info

# GM Operasyon Masası (bot ve ayrı Railway panel servisi ortak kullanır)
ADMIN_PANEL_BASE_URL=https://panel-servisiniz.up.railway.app
# Yalnız panele girebilecek Discord kullanıcı kimlikleri (virgülle ayrılır).
ADMIN_DISCORD_USER_IDS=
ADMIN_GUILD_ID=
# En az 32 karakterlik rastgele ve gizli bir değer; bot ile panelde aynı olmalıdır.
ADMIN_SESSION_SECRET=

# Yapay zekâ devlet yöneticisi. Altyapı varsayılan olarak kapalıdır; anahtar yalnız manuel taslak üretiminde kullanılır.
OPENAI_API_KEY=
AI_COUNTRY_MODEL=gpt-6-sol
